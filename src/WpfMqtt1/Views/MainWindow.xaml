<ui:FluentWindow
    x:Class="WpfMqtt1.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:WpfMqtt1.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=local:MainWindow, IsDesignTimeCreatable=False}"
    xmlns:local="clr-namespace:WpfMqtt1.Views"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/WpfMqtt1;component/Assets/app-icon.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/WpfMqtt1;component/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="20,8,20,20"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="210"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Client"
                    TargetPageType="{x:Type pages:ClientPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Brokers"
                    TargetPageType="{x:Type pages:BrokersPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Server24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="History"
                    TargetPageType="{x:Type pages:HistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Database24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="3" />

        <!-- Persistent Windows 11 Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="9"
                        Height="9"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{Binding ViewModel.ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.ConnectionStateText}" />
                </StackPanel>

                <ui:TextBlock
                    Grid.Column="1"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    Text="{Binding ViewModel.ActiveBrokerUri}"
                    TextTrimming="CharacterEllipsis" />

                <ui:Button
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ViewModel.DisconnectCommand}"
                    Content="Disconnect"
                    FontSize="11"
                    Icon="{ui:SymbolIcon PlugDisconnected20}"
                    Visibility="{Binding ViewModel.IsConnectedOrConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel
                    Grid.Column="3"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Mail20" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding ViewModel.MessageCount, StringFormat={}{0:N0} messages}" />
                </StackPanel>

                <Border
                    Grid.Column="4"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="#EF4444"
                            Visibility="{Binding ViewModel.IsRecording, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="{Binding ViewModel.RecordingStatusText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
