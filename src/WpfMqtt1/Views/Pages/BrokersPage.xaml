<Page
    x:Class="WpfMqtt1.Views.Pages.BrokersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMqtt1.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Brokers"
    d:DataContext="{d:DesignInstance Type=local:BrokersPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1040"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Master Pane: Broker List -->
        <ui:Card
            Grid.Column="0"
            Padding="14"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Subtitle"
                        Text="Brokers" />
                    <ui:Button
                        Grid.Column="1"
                        Appearance="Primary"
                        Command="{Binding ViewModel.AddBrokerCommand}"
                        Content="Add"
                        Icon="{ui:SymbolIcon Add20}" />
                </Grid>

                <ui:TextBox
                    x:Name="BrokerSearchBox"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search20}"
                    PlaceholderText="Filter brokers (Ctrl+F)..."
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:ListView
                    Grid.Row="2"
                    ItemsSource="{Binding ViewModel.FilteredBrokers}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding ViewModel.SelectedBroker, Mode=TwoWay}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="LockClosed20"
                                        Visibility="{Binding IsSecure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <ui:TextBlock
                                        Appearance="Secondary"
                                        FontTypography="Caption"
                                        Text="{Binding ProtocolDisplayName}" />
                                </Border>

                                <ui:TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,3,0,0"
                                    Appearance="Secondary"
                                    FontTypography="Caption"
                                    Text="{Binding DisplayUri}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding ViewModel.SelectedBroker, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <ui:SymbolIcon
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="Server24" />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="BodyStrong"
                        Text="No brokers found" />
                    <ui:TextBlock
                        Margin="12,4,12,0"
                        HorizontalAlignment="Center"
                        Appearance="Tertiary"
                        FontTypography="Caption"
                        Text="Click Add above to create your first MQTT broker profile."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Visibility="{Binding ViewModel.HasSelectedBroker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.DuplicateBrokerCommand}"
                        Content="Duplicate"
                        Icon="{ui:SymbolIcon Copy20}" />
                    <ui:Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.DeleteBrokerCommand}"
                        Content="Delete"
                        Icon="{ui:SymbolIcon Delete20}" />
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Right Detail Pane: Empty State -->
        <ui:Card
            Grid.Column="2"
            Padding="32"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Center"
            Visibility="{Binding ViewModel.SelectedBroker, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
            <StackPanel MaxWidth="420" HorizontalAlignment="Center">
                <ui:SymbolIcon
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    FontSize="44"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="ServerLink24" />
                <ui:TextBlock
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="Manage Your MQTT Brokers" />
                <ui:TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    Appearance="Secondary"
                    Text="Save connection profiles for local development brokers, cloud clusters, or WebSocket endpoints with encrypted credentials."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ui:Button
                    HorizontalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding ViewModel.AddBrokerCommand}"
                    Content="Create Broker Profile"
                    Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </ui:Card>

        <!-- Right Detail Pane: Broker Editor -->
        <Grid
            Grid.Column="2"
            Visibility="{Binding ViewModel.HasSelectedBroker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Editor Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock
                            FontTypography="Title"
                            Text="{Binding ViewModel.EditName}" />
                        <Border
                            Margin="12,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{Binding ViewModel.HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock
                                FontTypography="Caption"
                                FontWeight="SemiBold"
                                Text="Unsaved changes" />
                        </Border>
                    </StackPanel>
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding ViewModel.EditPreviewUri}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Margin="0,0,10,0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="4"
                        Visibility="{Binding ViewModel.IsSelectedBrokerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{Binding ViewModel.MqttConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                FontWeight="SemiBold"
                                Text="{Binding ViewModel.ActiveBrokerStateText}" />
                        </StackPanel>
                    </Border>

                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ViewModel.ConnectBrokerCommand}"
                        Content="Connect"
                        Icon="{ui:SymbolIcon PlugConnected20}"
                        Visibility="{Binding ViewModel.CanConnectSelectedBroker, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:Button
                        Command="{Binding ViewModel.DisconnectBrokerCommand}"
                        Content="Disconnect"
                        Icon="{ui:SymbolIcon PlugDisconnected20}"
                        Visibility="{Binding ViewModel.IsSelectedBrokerActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!-- Validation & Test Result Banners -->
            <StackPanel Grid.Row="1">
                <ui:InfoBar
                    Title="Check broker settings"
                    Margin="0,0,0,10"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{Binding ViewModel.ValidationErrorMessage}"
                    Severity="Error"
                    Visibility="{Binding ViewModel.ValidationErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <ui:InfoBar
                    Title="{Binding ViewModel.TestResultTitle}"
                    Margin="0,0,0,10"
                    IsClosable="True"
                    IsOpen="{Binding ViewModel.IsTestResultOpen, Mode=TwoWay}"
                    Message="{Binding ViewModel.TestResultMessage}"
                    Severity="{Binding ViewModel.TestResultSeverity}" />
            </StackPanel>

            <!-- Scrollable Form Sections -->
            <ScrollViewer
                x:Name="EditorScrollViewer"
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,16">

                    <!-- Section 1: General & Endpoint -->
                    <ui:Card Margin="0,0,0,12" Padding="18">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="18"
                                    Symbol="Globe24" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="Connection Endpoint" />
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Profile Name" />
                                    <ui:TextBox
                                        PlaceholderText="e.g. Local Mosquitto"
                                        Text="{Binding ViewModel.EditName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Transport" />
                                    <ComboBox
                                        ItemsSource="{Binding ViewModel.AvailableTransports}"
                                        SelectedItem="{Binding ViewModel.EditTransport, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Hostname / IP Address" />
                                    <ui:TextBox
                                        PlaceholderText="broker.example.com or 127.0.0.1"
                                        Text="{Binding ViewModel.EditHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Port" />
                                    <ui:NumberBox
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="65535"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding ViewModel.EditPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleToIntConverter}, ConverterParameter=1883}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding ViewModel.IsEditWebSocket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="WebSocket Path" />
                                <ui:TextBox
                                    PlaceholderText="/mqtt"
                                    Text="{Binding ViewModel.EditWebSocketPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Section 2: MQTT Protocol Options -->
                    <ui:Card Margin="0,0,0,12" Padding="18">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="18"
                                    Symbol="Options24" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="MQTT Protocol" />
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="MQTT Version" />
                                    <ComboBox
                                        ItemsSource="{Binding ViewModel.AvailableProtocolVersions}"
                                        SelectedItem="{Binding ViewModel.EditProtocolVersion, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Client ID" />
                                    <ui:TextBox
                                        PlaceholderText="Leave blank to auto-generate"
                                        Text="{Binding ViewModel.EditClientId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <ui:Button
                                    Grid.Column="4"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ViewModel.RandomizeClientIdCommand}"
                                    Icon="{ui:SymbolIcon ArrowSync20}"
                                    ToolTip="Generate random Client ID" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Keep-Alive (seconds)" />
                                    <ui:NumberBox
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="65535"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding ViewModel.EditKeepAliveSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleToIntConverter}, ConverterParameter=60}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Connection Timeout (seconds)" />
                                    <ui:NumberBox
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="300"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding ViewModel.EditConnectionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleToIntConverter}, ConverterParameter=10}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch
                                    Grid.Column="0"
                                    Content="Clean Session / Clean Start"
                                    IsChecked="{Binding ViewModel.EditCleanSession, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Grid.Column="1"
                                    Content="Auto-reconnect on drop"
                                    IsChecked="{Binding ViewModel.EditAutoReconnect, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Section 3: Authentication & TLS -->
                    <ui:Card Margin="0,0,0,12" Padding="18">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="18"
                                    Symbol="ShieldKeyhole24" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="Authentication &amp; TLS Security" />
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Username (optional)" />
                                    <ui:TextBox
                                        PlaceholderText="Broker username"
                                        Text="{Binding ViewModel.EditUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="Password (encrypted locally via DPAPI)" />
                                    <ui:PasswordBox
                                        Password="{Binding ViewModel.EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Broker password" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding ViewModel.IsEditSecure, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Margin="0,0,0,6" FontTypography="Caption" Text="TLS Protocol Version" />
                                        <ComboBox
                                            ItemsSource="{Binding ViewModel.AvailableTlsVersions}"
                                            SelectedItem="{Binding ViewModel.EditTlsVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <ui:ToggleSwitch
                                        Grid.Column="2"
                                        Margin="0,18,0,0"
                                        VerticalAlignment="Center"
                                        Content="Allow untrusted / self-signed certificates"
                                        IsChecked="{Binding ViewModel.EditAllowUntrustedCertificates, Mode=TwoWay}" />
                                </Grid>

                                <ui:InfoBar
                                    Title="Certificate validation disabled"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="Only enable this for local or development brokers using self-signed certificates."
                                    Severity="Warning"
                                    Visibility="{Binding ViewModel.EditAllowUntrustedCertificates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Section 4: Default Auto-Subscribe Topics -->
                    <ui:Card Padding="18">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="18"
                                    Symbol="BranchFork24" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="Default Auto-Subscribe Topics (Optional)" />
                            </StackPanel>

                            <ui:TextBlock
                                Margin="0,0,0,10"
                                Appearance="Secondary"
                                FontTypography="Caption"
                                Text="Topics listed here will be subscribed automatically whenever you connect to this broker." />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    PlaceholderText="e.g. sensors/# or home/+/temperature"
                                    Text="{Binding ViewModel.NewDefaultTopic, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding ViewModel.AddDefaultTopicCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <ui:Button
                                    Grid.Column="2"
                                    Command="{Binding ViewModel.AddDefaultTopicCommand}"
                                    Content="Add Topic"
                                    Icon="{ui:SymbolIcon Add20}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ViewModel.EditDefaultTopics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,8,8"
                                            Padding="10,4,6,4"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontTypography="Caption"
                                                    Text="{Binding}" />
                                                <ui:Button
                                                    Margin="6,0,0,0"
                                                    Padding="2"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.ViewModel.RemoveDefaultTopicCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Dismiss12}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Sticky Action Bar -->
            <Border
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding ViewModel.TestConnectionCommand}"
                            Content="Test Connection"
                            Icon="{ui:SymbolIcon Pulse20}" />
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="10,0,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsTestingConnection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="2"
                        Command="{Binding ViewModel.RevertChangesCommand}"
                        Content="Revert"
                        IsEnabled="{Binding ViewModel.HasUnsavedChanges}" />

                    <ui:Button
                        Grid.Column="4"
                        Appearance="Primary"
                        Command="{Binding ViewModel.SaveBrokerCommand}"
                        Content="Save Changes"
                        Icon="{ui:SymbolIcon Save20}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
