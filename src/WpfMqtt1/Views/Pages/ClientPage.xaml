<Page
    x:Class="WpfMqtt1.Views.Pages.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMqtt1.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Client"
    d:DataContext="{d:DesignInstance Type=local:ClientPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="640"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="0,0,8,24">
            <ui:TextBlock
                Margin="0,0,0,4"
                FontTypography="Title"
                Text="MQTT Client" />
            <ui:TextBlock
                Margin="0,0,0,20"
                Appearance="Secondary"
                Text="Connect to a broker, subscribe to multiple topics with wildcards, inspect Text/JSON/Hex/Base64 payloads, and publish messages." />

            <!-- Live Connection Status Banner -->
            <ui:Card Margin="0,0,0,16" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{Binding ViewModel.ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="BodyStrong"
                                Text="{Binding ViewModel.ConnectionStateText}" />
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0,4,0,0"
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="{Binding ViewModel.ActiveBrokerDisplay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding ViewModel.DisconnectCommand}"
                            Content="Disconnect"
                            Icon="{ui:SymbolIcon PlugDisconnected20}"
                            Visibility="{Binding ViewModel.IsConnectedOrConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ViewModel.OpenBrokersCommand}"
                            Content="Manage Brokers"
                            Icon="{ui:SymbolIcon Server20}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            FontSize="22"
                            Symbol="PlugConnected24" />
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontTypography="Subtitle"
                            Text="Live Workspace Coming in Phase 3" />
                    </StackPanel>

                    <ui:TextBlock
                        Margin="0,0,0,16"
                        Appearance="Secondary"
                        Text="Your broker connection is active and monitored live in real time. Phase 3 will add multi-topic subscriptions, the virtualized live message feed, the Text/JSON/Hex/Base64 payload inspector, and the publisher panel right here."
                        TextWrapping="Wrap" />

                    <ui:Button
                        Command="{Binding ViewModel.OpenSettingsCommand}"
                        Content="Appearance &amp; Settings"
                        Icon="{ui:SymbolIcon Settings20}" />
                </StackPanel>
            </ui:Card>

            <UniformGrid Columns="3">
                <ui:Card Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            FontSize="20"
                            Symbol="BranchFork24" />
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="BodyStrong"
                            Text="Multi-Topic Subscriptions" />
                        <ui:TextBlock
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="Subscribe to multiple topics with + and # wildcards, QoS levels, and per-topic counters."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="4,0,4,0" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            FontSize="20"
                            Symbol="Code24" />
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="BodyStrong"
                            Text="Text, JSON, Hex &amp; Base64" />
                        <ui:TextBlock
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="Inspect incoming and outgoing payloads losslessly with JSON formatting and hex dumps."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            FontSize="20"
                            Symbol="Database24" />
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="BodyStrong"
                            Text="Offline SQLite Sessions" />
                        <ui:TextBlock
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="Toggle session recording to capture traffic to SQLite and browse or export it offline."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
