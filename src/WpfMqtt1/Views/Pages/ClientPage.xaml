<Page
    x:Class="WpfMqtt1.Views.Pages.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfMqtt1.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMqtt1.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Client"
    d:DataContext="{d:DesignInstance Type=local:ClientPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1120"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="10" />
            <RowDefinition Height="195" MinHeight="145" MaxHeight="380" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Connection Toolbar -->
        <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox
                        MinWidth="240"
                        MaxWidth="320"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding ViewModel.IsDisconnected}"
                        ItemsSource="{Binding ViewModel.AvailableBrokers}"
                        SelectedItem="{Binding ViewModel.SelectedBroker, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Opacity="0.65"
                                        Text="{Binding DisplayUri}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ViewModel.ConnectCommand}"
                        Content="Connect"
                        Icon="{ui:SymbolIcon PlugConnected20}"
                        Visibility="{Binding ViewModel.IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:Button
                        Command="{Binding ViewModel.DisconnectCommand}"
                        Content="Disconnect"
                        Icon="{ui:SymbolIcon PlugDisconnected20}"
                        Visibility="{Binding ViewModel.IsConnectedOrConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="10,0,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding ViewModel.IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="9"
                        Height="9"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{Binding ViewModel.ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="{Binding ViewModel.ConnectionStateText}" />
                    <ui:TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding ViewModel.ActiveBrokerDisplay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ui:Button
                    Grid.Column="3"
                    Command="{Binding ViewModel.OpenBrokersCommand}"
                    Content="Brokers"
                    Icon="{ui:SymbolIcon Server20}"
                    ToolTip="Manage MQTT broker profiles" />
            </Grid>
        </ui:Card>

        <!-- Row 1: Main 3-Pane Workspace (Subscriptions | Live Feed | Payload Inspector) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" MinWidth="200" MaxWidth="420" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="360" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Subscriptions -->
            <ui:Card
                Grid.Column="0"
                Padding="12"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Symbol="BranchFork24" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="Subscriptions" />
                    </StackPanel>

                    <ui:TextBox
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        IsEnabled="{Binding ViewModel.IsConnected}"
                        PlaceholderText="Topic filter (e.g. sensors/#)"
                        Text="{Binding ViewModel.NewSubscribeTopic, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ViewModel.SubscribeCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            IsEnabled="{Binding ViewModel.IsConnected}"
                            ItemsSource="{Binding ViewModel.AvailableQosLevels}"
                            SelectedItem="{Binding ViewModel.NewSubscribeQos, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=QoS {0}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding ViewModel.SubscribeCommand}"
                            Content="Subscribe"
                            Icon="{ui:SymbolIcon Add20}" />
                    </Grid>

                    <ui:ListView
                        Grid.Row="3"
                        ItemsSource="{Binding ViewModel.Subscriptions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse
                                            Grid.Column="0"
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />

                                        <ui:TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontTypography="BodyStrong"
                                            Text="{Binding TopicFilter}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding TopicFilter}" />

                                        <Border
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <ui:TextBlock
                                                Appearance="Secondary"
                                                FontTypography="Caption"
                                                Text="{Binding MessageCount, StringFormat={}{0:N0}}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="16,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                Appearance="Secondary"
                                                FontTypography="Caption"
                                                Text="{Binding QosLabel}" />
                                            <ui:TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Appearance="Tertiary"
                                                FontTypography="Caption"
                                                Text="Muted"
                                                Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.ViewModel.UseTopicInPublisherCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Send16}"
                                                ToolTip="Use topic in Publisher" />
                                            <ui:Button
                                                Margin="2,0,0,0"
                                                Padding="4"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.ViewModel.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon SpeakerMute16}"
                                                ToolTip="Mute / unmute messages in feed" />
                                            <ui:Button
                                                Margin="2,0,0,0"
                                                Padding="4"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.ViewModel.UnsubscribeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Dismiss16}"
                                                ToolTip="Unsubscribe" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>

                    <!-- Empty Subscriptions Hint -->
                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.Subscriptions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="No active subscriptions" />
                        <ui:TextBlock
                            MaxWidth="190"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Tertiary"
                            FontTypography="Caption"
                            Text="Connect to a broker and subscribe to topics such as # or home/+/temp."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!-- Center Panel: Live Message Feed -->
            <ui:Card
                Grid.Column="2"
                Padding="12"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Row 1: Search + Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            x:Name="FeedSearchBox"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search20}"
                            PlaceholderText="Search topic or payload..."
                            Text="{Binding ViewModel.FeedSearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton
                                Margin="0,0,6,0"
                                Padding="8,5"
                                IsChecked="{Binding ViewModel.IsAutoScrollEnabled, Mode=TwoWay}"
                                ToolTip="Auto-scroll to latest message">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,4,0" FontSize="14" Symbol="ArrowDown16" />
                                    <TextBlock FontSize="12" Text="Auto" />
                                </StackPanel>
                            </ToggleButton>

                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="8,5"
                                Command="{Binding ViewModel.TogglePauseCommand}"
                                Content="{Binding ViewModel.PauseButtonText}"
                                FontSize="12"
                                Icon="{ui:SymbolIcon Pause16}"
                                ToolTip="Pause or resume live feed updates" />

                            <ui:Button
                                Padding="8,5"
                                Command="{Binding ViewModel.ClearMessagesCommand}"
                                Icon="{ui:SymbolIcon Delete16}"
                                ToolTip="Clear live feed" />
                        </StackPanel>
                    </Grid>

                    <!-- Filter Row 2: Direction + Topic Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            ItemsSource="{Binding ViewModel.AvailableDirectionFilters}"
                            SelectedItem="{Binding ViewModel.DirectionFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox
                            Grid.Column="2"
                            ItemsSource="{Binding ViewModel.TopicFilterOptions}"
                            SelectedItem="{Binding ViewModel.SelectedTopicFilter, Mode=TwoWay}" />
                    </Grid>

                    <!-- Virtualized Message Feed List -->
                    <ui:ListView
                        x:Name="MessageFeedListView"
                        Grid.Row="2"
                        ItemsSource="{Binding ViewModel.VisibleMessages}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding ViewModel.SelectedMessage, Mode=TwoWay}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Margin="0,2,0,2"
                                        Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="2" />

                                    <Grid Grid.Column="1" Margin="8,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}, ConverterParameter=Bg}"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"
                                                    Text="{Binding DirectionArrow}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Topic}"
                                                TextTrimming="CharacterEllipsis" />

                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Border
                                                    Margin="0,0,5,0"
                                                    Padding="5,1"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{Binding Retain, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Text="RET" />
                                                </Border>
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding QosLabel}" />
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding SizeDisplay}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding TimestampDisplay}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,3,0,0"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding PayloadPreview}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>

                    <!-- Empty Feed Placeholder -->
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.VisibleMessages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="Mail24" />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            Appearance="Secondary"
                            FontTypography="BodyStrong"
                            Text="Waiting for messages" />
                        <ui:TextBlock
                            MaxWidth="260"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Tertiary"
                            FontTypography="Caption"
                            Text="Incoming subscribed messages and your published messages will appear here in real time."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <GridSplitter
                Grid.Column="3"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!-- Right Panel: Reusable Payload Inspector -->
            <controls:PayloadInspectorControl
                Grid.Column="4"
                Message="{Binding ViewModel.SelectedMessage}"
                SelectedFormat="{Binding ViewModel.InspectorFormat, Mode=TwoWay}" />
        </Grid>

        <!-- Row 2: Horizontal Splitter -->
        <GridSplitter
            Grid.Row="2"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />

        <!-- Row 3: Bottom Docked Publisher -->
        <ui:Card
            Grid.Row="3"
            Padding="12"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Publish Header Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="Publish" />

                    <ComboBox
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        IsEditable="True"
                        ItemsSource="{Binding ViewModel.RecentPublishTopics}"
                        Text="{Binding ViewModel.PublishTopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Publish topic (must not contain + or # wildcards)" />

                    <ComboBox
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding ViewModel.AvailableQosLevels}"
                        SelectedItem="{Binding ViewModel.PublishQos, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=QoS {0}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Retain"
                        IsChecked="{Binding ViewModel.PublishRetain, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="4"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding ViewModel.AvailablePayloadFormats}"
                        SelectedItem="{Binding ViewModel.PublishFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:Button
                        Grid.Column="5"
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.FormatPublishJsonCommand}"
                        Content="Format JSON"
                        Icon="{ui:SymbolIcon Code16}"
                        Visibility="{Binding ViewModel.IsJsonPublishFormat, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:Button
                        Grid.Column="6"
                        Appearance="Primary"
                        Command="{Binding ViewModel.PublishCommand}"
                        Content="Publish"
                        Icon="{ui:SymbolIcon Send20}"
                        ToolTip="Publish message (Ctrl+Enter)" />
                </Grid>

                <!-- Live Validation Message -->
                <ui:TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,6"
                    FontTypography="Caption"
                    Foreground="#F87171"
                    Text="{Binding ViewModel.PublishValidationError}"
                    Visibility="{Binding ViewModel.PublishValidationError, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Payload Editor -->
                <TextBox
                    Grid.Row="2"
                    Padding="10,8"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    HorizontalScrollBarVisibility="Auto"
                    Text="{Binding ViewModel.PublishPayload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto">
                    <TextBox.InputBindings>
                        <KeyBinding
                            Key="Return"
                            Command="{Binding ViewModel.PublishCommand}"
                            Modifiers="Control" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
