<Page
    x:Class="WpfMqtt1.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfMqtt1.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMqtt1.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="History"
    d:DataContext="{d:DesignInstance Type=local:HistoryPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="1120"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="305" MinWidth="240" MaxWidth="440" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="360" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Recorded SQLite Sessions -->
        <ui:Card
            Grid.Column="0"
            Padding="14"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Symbol="Database24" />
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontTypography="Subtitle"
                            Text="Sessions" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Command="{Binding ViewModel.RefreshCommand}"
                        Icon="{ui:SymbolIcon ArrowSync20}"
                        ToolTip="Refresh recorded sessions" />
                </Grid>

                <ui:TextBox
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search20}"
                    PlaceholderText="Filter sessions or brokers..."
                    Text="{Binding ViewModel.SessionSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    ItemsSource="{Binding ViewModel.AvailableDateFilters}"
                    SelectedItem="{Binding ViewModel.SelectedDateFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:ListView
                    Grid.Row="3"
                    ItemsSource="{Binding ViewModel.Sessions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding ViewModel.SelectedSession, Mode=TwoWay}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontTypography="BodyStrong"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <ui:TextBlock
                                        Appearance="Secondary"
                                        FontTypography="Caption"
                                        Text="{Binding MessageCountDisplay}" />
                                </Border>

                                <ui:TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,3,0,0"
                                    Appearance="Secondary"
                                    FontTypography="Caption"
                                    Text="{Binding BrokerAddress}"
                                    TextTrimming="CharacterEllipsis" />

                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock
                                        Grid.Column="0"
                                        Appearance="Tertiary"
                                        FontTypography="Caption"
                                        Text="{Binding StartedAtDisplay}" />
                                    <ui:TextBlock
                                        Grid.Column="1"
                                        Appearance="Tertiary"
                                        FontTypography="Caption"
                                        Text="{Binding DurationDisplay}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <!-- Empty Sessions State -->
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.Sessions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="Database24" />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="BodyStrong"
                        Text="No recorded sessions" />
                    <ui:TextBlock
                        MaxWidth="210"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Tertiary"
                        FontTypography="Caption"
                        Text="Use Record SQLite on the Client page to capture sessions for offline review."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Session Actions -->
                <Grid
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    Visibility="{Binding ViewModel.HasSelectedSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.RenameSessionCommand}"
                        Content="Rename"
                        Icon="{ui:SymbolIcon Edit20}" />
                    <ui:Button
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.DeleteSessionCommand}"
                        Content="Delete"
                        Icon="{ui:SymbolIcon Delete20}" />

                    <ui:Button
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.ExportCsvCommand}"
                        Content="Export CSV"
                        Icon="{ui:SymbolIcon DocumentTable20}" />
                    <ui:Button
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.ExportJsonCommand}"
                        Content="Export JSON"
                        Icon="{ui:SymbolIcon Code20}" />
                </Grid>
            </Grid>
        </ui:Card>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />

        <!-- Center Pane: Offline Message Log -->
        <ui:Card
            Grid.Column="2"
            Padding="14"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Session Summary Header -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Visibility="{Binding ViewModel.HasSelectedSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ui:TextBlock
                            FontTypography="Subtitle"
                            Text="{Binding ViewModel.SelectedSession.Name}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="{Binding ViewModel.SelectedSession.BrokerAddress}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding ViewModel.MessageCountSummary}" />
                </Grid>

                <!-- Search Input -->
                <ui:TextBox
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search20}"
                    IsEnabled="{Binding ViewModel.HasSelectedSession}"
                    PlaceholderText="Search topic or payload..."
                    Text="{Binding ViewModel.MessageSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Direction & Topic Filters -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        IsEnabled="{Binding ViewModel.HasSelectedSession}"
                        ItemsSource="{Binding ViewModel.AvailableDirectionFilters}"
                        SelectedItem="{Binding ViewModel.MessageDirectionFilter, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox
                        Grid.Column="2"
                        IsEnabled="{Binding ViewModel.HasSelectedSession}"
                        ItemsSource="{Binding ViewModel.TopicFilterOptions}"
                        SelectedItem="{Binding ViewModel.SelectedTopicFilter, Mode=TwoWay}" />
                </Grid>

                <!-- Virtualized Offline Message DataGrid (Sortable by Date/Time and Topic) -->
                <ui:DataGrid
                    x:Name="MessagesDataGrid"
                    Grid.Row="3"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.SessionMessages}"
                    RowHeaderWidth="0"
                    ScrollViewer.CanContentScroll="True"
                    SelectedItem="{Binding ViewModel.SelectedMessage, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Sorting="MessagesDataGrid_Sorting"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn
                            x:Name="TimestampColumn"
                            Width="168"
                            MinWidth="145"
                            CanUserSort="True"
                            Header="Date / Time"
                            SortDirection="Ascending"
                            SortMemberPath="TimestampUtc">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TimestampFullDisplay}"
                                        ToolTip="{Binding TimestampFullDisplay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="66"
                            MinWidth="58"
                            CanUserSort="False"
                            Header="Dir">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="5,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}, ConverterParameter=Bg}"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"
                                            Text="{Binding DirectionArrow}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            x:Name="TopicColumn"
                            Width="*"
                            MinWidth="140"
                            CanUserSort="True"
                            Header="Topic"
                            SortMemberPath="Topic">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="2,2"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Topic}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Topic}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Empty Messages State -->
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.SessionMessages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="Mail24" />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        Appearance="Secondary"
                        FontTypography="BodyStrong"
                        Text="No messages to display" />
                    <ui:TextBlock
                        MaxWidth="260"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Tertiary"
                        FontTypography="Caption"
                        Text="Select a recorded session on the left or adjust your search filters."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <GridSplitter
            Grid.Column="3"
            Width="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />

        <!-- Right Pane: Shared Offline Payload Inspector -->
        <controls:PayloadInspectorControl
            Grid.Column="4"
            Message="{Binding ViewModel.SelectedMessage}"
            SelectedFormat="{Binding ViewModel.InspectorFormat, Mode=TwoWay}" />
    </Grid>
</Page>
